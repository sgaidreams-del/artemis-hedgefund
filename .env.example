# ============================================================================
# Artemis environment configuration
#
# The easy way: run ./install.sh (or `python scripts/configure.py` to change
# keys later). It prompts for each value, hides secrets as you type, and
# writes .env with owner-only permissions.
#
# The manual way: cp .env.example .env, then fill in values below.
# NEVER commit .env — it is listed in .gitignore.
# ============================================================================

# ── Broker (Alpaca) — REQUIRED ──────────────────────────────────────────────
# Free paper-trading account: https://app.alpaca.markets/signup
# Use PAPER keys. The paper URL below is the default and strongly recommended.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ── LLM (DeepSeek, OpenAI-compatible) — REQUIRED for LLM features ───────────
# https://platform.deepseek.com/ — powers sentiment, bull/bear debate,
# post-trade reflections, missed-mover analysis and calendar plans.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Alternative data (Finnhub) — optional, free tier ────────────────────────
# Insider transactions + earnings calendar: https://finnhub.io/register
FINNHUB_API_KEY=

# ── Macro data (FRED) — optional, free ──────────────────────────────────────
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Market data (Polygon.io) — optional, paid ───────────────────────────────
# Fallback price source. https://polygon.io/pricing
POLYGON_API_KEY=

# ── Social (Reddit / PRAW) — optional, free ─────────────────────────────────
# https://www.reddit.com/prefs/apps  (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=artemis/0.1

# ── Database ────────────────────────────────────────────────────────────────
# Docker (docker-compose.yaml) listens on 5433; a Homebrew/system Postgres on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=artemis
POSTGRES_USER=artemis
# Generated by install.sh. If setting manually, use a long random string.
POSTGRES_PASSWORD=

# ── Cache / queue ───────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Discord — optional, legacy (superseded by the web dashboard) ────────────
DISCORD_ARTEMIS_TOKEN=
DISCORD_HEDGEFUND_CHANNEL_ID=

# ── Feature flags ───────────────────────────────────────────────────────────
FINRL_ENABLED=false
OPTIONS_FLOW_ENABLED=true
OPTIONS_EXECUTION_ENABLED=false   # options order submission (requires Alpaca options approval)
OPTIONS_EARNINGS_ENABLED=false
OPTIONS_HEDGE_ENABLED=false

# ── Dashboard API access (advanced) ─────────────────────────────────────────
# The API only accepts Host localhost/127.0.0.1 and writes from the local
# dashboard origin. Only widen these if you understand SECURITY.md — the API
# has no login.
# ARTEMIS_ALLOWED_HOSTS=myhost.local
# ARTEMIS_ALLOWED_ORIGINS=http://myhost.local:5173

# ── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=paper   # paper | live — Artemis is built and tested for PAPER trading only
